{
  "topic": "AI 기업 · 모델 · 제품 생태계",

  "schema": {
    "node_types": ["Company", "Person", "Model", "Product"],
    "relation_types": [
      { "name": "FOUNDED", "domain": "Person", "range": "Company", "description": "사람이 회사를 설립함" },
      { "name": "WORKED_AT", "domain": "Person", "range": "Company", "description": "사람이 회사에서 재직했거나 재직 중임" },
      { "name": "LEADS", "domain": "Person", "range": "Company", "description": "사람이 회사의 현재 대표/CEO/사장임" },
      { "name": "DEVELOPED", "domain": "Company", "range": "Model", "description": "회사가 모델을 만듦" },
      { "name": "RELEASED", "domain": "Company", "range": "Product", "description": "회사가 제품을 출시함" },
      { "name": "BUILT_ON", "domain": "Product", "range": "Model", "description": "제품이 특정 모델을 기반으로 함" },
      { "name": "ACQUIRED", "domain": "Company", "range": "Company", "description": "회사가 다른 회사를 인수함" },
      { "name": "INVESTED_IN", "domain": "Company", "range": "Company", "description": "회사가 다른 회사에 지분·자금을 투자함 (경영권 이전 없음)" },
      { "name": "PARTNERED_WITH", "domain": "Company", "range": "Company", "description": "두 회사가 인수·투자 없이 협력함" },
      { "name": "PARENT_OF", "domain": "Company", "range": "Company", "description": "회사가 다른 회사의 모회사임 (자회사 구조)" },
      { "name": "RUNS_ON", "domain": "Product", "range": "Company", "description": "제품이 특정 회사의 인프라/하드웨어로 구동됨" }
    ]
  },

  "extraction": {
    "model": "gpt-4o-mini",
    "chunk_chars": 2500,
    "chunk_overlap_chars": 200,
    "max_workers": 8,
    "temperature": 0,
    "force_rebuild": false
  },

  "normalization": {
    "comment": "표기 통일(별칭 병합)에 쓰는 규칙. alias_map의 key는 LLM 추출 결과에 나타날 수 있는 변형 표기, value는 코퍼스 문서 제목과 일치시킨 정규 표기.",
    "generic_noun_stoplist": [
      "회사", "기업", "모델", "제품", "인공지능", "AI", "챗봇", "스타트업", "빅테크",
      "언어 모델", "대형 언어 모델", "생성형 인공지능", "딥 러닝", "클라우드"
